# RevenueCat public SDK keys.
# Copy this file to .env.local (git-ignored). Do not commit real keys.
#
# Expo inlines EXPO_PUBLIC_* into the JS bundle at BUILD time. A local Gradle
# release build (:app:assembleRelease / :app:bundleRelease) reads these from
# .env.local, so set the PRODUCTION values there before building for the store.

# --- DEVELOPMENT ONLY: RevenueCat Test Store ---------------------------------
# Leave BOTH of these EMPTY for a production/store build. Setting the flag to 1
# forces the Test Store and must never ship in a release.
EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# --- PRODUCTION: real public SDK keys ----------------------------------------
# RevenueCat dashboard > Project settings > API keys (the app-specific *public*
# SDK keys). Android starts with "goog_", iOS with "appl_".
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# --- ADS: force Google TEST ad units ------------------------------------------
# Set to 1 ONLY for Play closed-testing / internal-testing builds, so testers can
# never load or tap a real ad (the #1 cause of AdMob account bans). __DEV__ builds
# already serve test ads without this.
#
# MUST BE EMPTY FOR A PRODUCTION BUILD. Metro inlines EXPO_PUBLIC_* at BUILD time,
# so a bundle made with this set serves test ads forever and earns $0 — it cannot
# be "fixed" by unsetting the var later. A build with this flag on logs a loud
# warning at startup (src/features/ads/ad-config.ts) and must never be promoted;
# cut production separately with the flag unset and a higher versionCode.
EXPO_PUBLIC_ADS_USE_TEST=

# --- Expo Go demo mode (local only) -------------------------------------------
# Set to 1 by `npm run start:demo`. Aliases react-native-compressor and
# react-native-background-actions to JS stubs (metro.config.js) so the app can run
# in Expo Go without a dev client. Never set this for a real build.
EXPO_PUBLIC_EXPO_GO_DEMO=
