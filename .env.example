# RevenueCat public SDK keys.
# Copy this file to .env.local (git-ignored). Do not commit real keys.
#
# Expo inlines EXPO_PUBLIC_* into the JS bundle at BUILD time. A local Gradle
# release build (:app:assembleRelease / :app:bundleRelease) reads these from
# .env.local, so set the PRODUCTION values there before building for the store.

# --- DEVELOPMENT ONLY: RevenueCat Test Store ---------------------------------
# Leave BOTH of these EMPTY for a production/store build. Setting the flag to 1
# forces the Test Store and must never ship in a release.
EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# --- PRODUCTION: real public SDK keys ----------------------------------------
# RevenueCat dashboard > Project settings > API keys (the app-specific *public*
# SDK keys). Android starts with "goog_", iOS with "appl_".
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
